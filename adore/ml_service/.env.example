# Adore ML service — copy to `.env` and adjust. All keys are optional.

# CORS: "*" for local demos, or comma-separated origins for locked-down hosts.
ADORE_CORS_ORIGINS=*

# Shared secret. When set, clients must send header: X-API-Key: <value>
# Leave empty for open local demos.
ADORE_API_KEY=

# Detector (Stage A YOLO)
ADORE_DETECTOR_ENABLED=1
ADORE_DETECTOR_WEIGHTS=yolov8n.pt
ADORE_DETECTOR_CONFIDENCE=0.35
ADORE_DETECTOR_IOU=0.70
ADORE_DETECTOR_MIN_BOX=0.04
ADORE_DETECTOR_MAX_BOXES=12
# ADORE_POSE_WEIGHTS=

# Classifier floors
ADORE_CLASSIFIER_MIN_CONF=0.38
ADORE_REFINE_MIN_CONF=0.38
ADORE_ITEM_MIN_CONF=0.12
ADORE_HUMAN_REVIEW_MIN_CONF=0.45
ADORE_MIN_CROP_PX=36
